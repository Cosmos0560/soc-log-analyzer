# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (project venv plus the two check venvs)
.venv/
.venv-wsl/
.venv-release/
venv/
env/

# Testing / tooling
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Graphify (local code graph): never committed
graphify-out/
.graphifyignore

# SQLite databases generated by running the tool
*.db
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store

# Real log files you might drop in locally for testing —
# never commit real system logs, only the synthetic ones in examples/
*.log
!examples/*.log
